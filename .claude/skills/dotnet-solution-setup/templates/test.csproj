<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Multi-target so net8.0 code paths (and the netstandard2.0 polyfill surface reachable through
         them) are actually exercised alongside net10.0. A single-TFM library or an app gets net10.0
         alone — the test project mirrors the TFMs of the project under test. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- v3 test projects are executables; Main is generated by xunit.v3.core. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/{{PROJECT}}/{{PROJECT}}.csproj" />
  </ItemGroup>
  <!-- Fixture copy-glob: files the suite loads by relative path next to the test assembly (CSV test
       vectors, PEM keys, raw binary fixtures, expected-output text). Keep only the extensions this
       suite actually loads that way, and drop the rest. -->
  <ItemGroup>
    <None Update="**/*.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="**/*.pem">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="**/*.key">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="**/*.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="**/*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
